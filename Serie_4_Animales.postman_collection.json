{
  "info": {
    "name": "Serie 4 · API de Animales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "animal_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Crear animal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/animales",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Luna\",\n  \"especie\": \"Perro\",\n  \"raza\": \"Labrador\",\n  \"edad\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Respuesta JSON esperada', () => {",
              "    pm.expect(pm.response.code).to.equal(201);",
              "    const animal = pm.response.json();",
              "    pm.expect(animal.id).to.be.a('number');",
              "    pm.collectionVariables.set('animal_id', String(animal.id));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Listar animales",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/animales"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON esperada', () => {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "    const animales = pm.response.json();",
              "    pm.expect(animales.some(animal => String(animal.id) === pm.collectionVariables.get('animal_id'))).to.equal(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Consultar por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/animales/{{animal_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON esperada', () => {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "    pm.expect(String(pm.response.json().id)).to.equal(pm.collectionVariables.get('animal_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Actualizar animal",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/animales/{{animal_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Luna\",\n  \"especie\": \"Perro\",\n  \"raza\": \"Labrador\",\n  \"edad\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON esperada', () => {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "    pm.expect(pm.response.json().edad).to.equal(4);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Enviar datos inválidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/animales",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Luna\",\n  \"especie\": \"Perro\",\n  \"edad\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 422', () => pm.response.to.have.status(422));",
              "pm.test('Respuesta JSON esperada', () => {",
              "    pm.expect(pm.response.code).to.equal(422);",
              "    pm.expect(pm.response.json().errors).to.have.property('raza');",
              "    pm.expect(pm.response.json().errors).to.have.property('edad');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Eliminar animal",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/animales/{{animal_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON esperada', () => {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "    pm.expect(pm.response.json().mensaje).to.equal('Animal eliminado correctamente.');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
